{
  "permissions": {
    "additionalDirectories": [
      "@WORK_DIR@",
      "/tmp"
    ],
    "allow": [
      "Agent",
      "Task",
      "Read(//home/runner/.claude/**)",
      "Read(//usr/local/bin/**)",
      "Bash(git:*)",
      "Bash(stack:*)",
      "Bash(date:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(uv:*)",
      "Bash(uvx:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(make:*)",
      "Bash(ssh-keygen:*)",
      "Bash(rsync:*)",
      "Bash(curl:*)",
      "Bash(chromium:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(tsc:*)",
      "Bash(vitest:*)",
      "Bash(vite:*)",
      "Bash(vue-tsc:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(stylelint:*)",
      "Bash(playwright:*)",
      "Bash(prek:*)",
      "Bash(env:*)",
      "Bash(GIT_EDITOR=*)",
      "Bash(GIT_SEQUENCE_EDITOR=*)",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(jq:*)",
      "Bash(diff:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(tee:*)",
      "Bash(od:*)",
      "Bash(sha256sum:*)",
      "Bash(rg:*)",
      "Bash(tar:*)",
      "Bash(ln:*)",
      "Bash(ps:*)",
      "Bash(pgrep:*)",
      "Bash(printenv:*)",
      "Bash(msgfmt:*)",
      "Bash(msgattrib:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(test:*)",
      "Bash(sleep:*)",
      "Bash(python3:*)",
      "Bash(gh pr comment:*)",
      "Bash(claude-job-checks:*)",
      "Bash(claude-job-part continue)",
      "Bash(claude-job-clone:*)",
      "Bash(claude-job-pr-comments:*)",
      "Bash(gh api --method PATCH repos/*/pulls/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/claude-job-vouch --hook"
          },
          {
            "type": "command",
            "command": "/usr/local/bin/claude-job-checks --hook"
          }
        ]
      }
    ]
  }
}
